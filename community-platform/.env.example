# Kopieer dit bestand naar .env.local en vul de waarden in.
# Te vinden in het Supabase-dashboard: Project Settings -> API

# Veilig voor de browser (anon key valt onder RLS):
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# UITSLUITEND server-side. Nooit met NEXT_PUBLIC_-prefix, nooit in client code.
# Wordt pas gebruikt vanaf stap 2 (leden uitnodigen via de Admin API).
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
