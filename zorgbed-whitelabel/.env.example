# ── Actief merk (white-label) ──
# Kies welk merk uit src/brand.ts getoond wordt. Leeg = standaardmerk (kersten).
# Opties in deze repo: kersten | zorgcomfort
VITE_BRAND=kersten

# Supabase
VITE_SUPABASE_URL=https://JOUW-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Dealer tracking (optioneel — per domein/subdomein)
VITE_DEALER_ID=

# Supabase Edge Function secrets (instellen via Supabase dashboard of CLI)
# supabase secrets set RESEND_API_KEY=re_xxxx
# supabase secrets set RECIPIENT_EMAIL=info@kerstenhulpmiddelen.nl
# supabase secrets set EMAIL_FROM="Kersten Hulpmiddelen <noreply@kerstenhulpmiddelen.nl>"
RESEND_API_KEY=re_xxxx
RECIPIENT_EMAIL=info@kerstenhulpmiddelen.nl
# Afzender van de e-mails — per merk instelbaar (geverifieerd Resend-domein).
EMAIL_FROM=Kersten Hulpmiddelen <noreply@kerstenhulpmiddelen.nl>
